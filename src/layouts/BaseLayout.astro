---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.scss';

interface Props {
  title: string;
  description?: string;
  /** Set on article pages so Open Graph reports the right type. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Suppress the site-name suffix (used on the homepage). */
  bareTitle?: boolean;
  /** Wider shell, so the article page can put a TOC rail beside the prose. */
  wide?: boolean;
  /** Social preview image. Re-rendered at 1200x630 for Open Graph. */
  image?: ImageMetadata;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  modifiedTime,
  bareTitle = false,
  wide = false,
  image,
} = Astro.props;

const pageTitle = bareTitle ? title : `${title} — ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

// Crawlers do not resolve relative URLs and do not run JS, so the preview image
// has to be absolute and already the right shape. 1200x630 is the ratio every
// major platform crops to.
const og = image
  ? await getImage({ src: image, width: 1200, height: 630, format: 'jpeg' })
  : undefined;
const ogImage = og ? new URL(og.src, Astro.site ?? SITE.url).href : undefined;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/*
      Favicon follows the BROWSER/OS colour scheme, not the site's theme toggle.
      The tab icon sits in browser chrome, so it should match that chrome rather
      than the page.

      `media` on icon links is honoured by Chromium and Safari; Firefox ignores
      it and falls back to the .ico below, which is why that comes first.
    */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link
      rel="icon"
      type="image/png"
      href="/light-favicon-32.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      href="/dark-favicon-32.png"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href="/rss.xml"
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}

    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={description} />
      </>
    )}

    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    {/*
      Runs before first paint, so the stored theme is applied while the page is
      still parsing. `is:inline` is essential: Astro would otherwise bundle this
      as a deferred module, which executes after paint and produces exactly the
      flash of wrong theme this exists to prevent.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
        } catch (e) {
          // Storage unavailable: fall through to prefers-color-scheme.
        }
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Header />

    <main id="main" class="site-main">
      <div class:list={['layout', wide && 'layout--wide']}>
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
