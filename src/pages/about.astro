---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import { SITE, SOCIAL_LINKS } from '../consts';
---

<BaseLayout title="About" description={`About ${SITE.author}.`}>
  <div class="page-header">
    <h1 class="page-header__title">About</h1>
  </div>

  <div class="prose">
    <p>
      I write about systems programming, web architecture, and the parts of
      software that only make sense once you have broken them yourself.
    </p>
    <p>
      This site is built with Astro, deployed to Cloudflare, and written in
      Markdown kept in git. There is no CMS and no database — which means there
      is nothing to go down, and nothing to migrate away from.
    </p>
    <p>
      You can subscribe via <a href="/rss.xml">RSS</a>.
    </p>
  </div>

  <section class="section">
    <div class="section__head">
      <h2 class="section__title">Elsewhere</h2>
    </div>

    <ul class="social-list" role="list">
      {SOCIAL_LINKS.map((link) => {
        const external = !link.href.startsWith('mailto:');
        return (
          <li>
            <a
              href={link.href}
              class="social-link"
              rel={external ? 'me noopener noreferrer' : 'me'}
              target={external ? '_blank' : undefined}
            >
              <Icon name={link.icon as IconName} class="social-link__icon" />
              <span class="social-link__name">{link.name}</span>
              <span class="social-link__handle">{link.handle}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>
