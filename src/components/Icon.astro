---
// Inline SVG icons.
//
// Two kinds:
//   - Stroke icons: monochrome, inherit currentColor, take the colour of
//     surrounding text for free. Add one by adding an entry to ICONS.
//   - Badge icons: fixed brand colours and their own background (the classic
//     RSS feed mark). These deliberately ignore currentColor.
//
// Sized in em so an icon always matches the text beside it.

const ICONS = {
  rss: ['M4 11a9 9 0 0 1 9 9', 'M4 4a16 16 0 0 1 16 16'],
  github: [
    'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22',
  ],
  mail: ['M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z', 'm22 6-10 7L2 6'],
} as const;

/** Icons drawn with a filled dot in addition to their stroked paths. */
const DOTS: Partial<Record<keyof typeof ICONS, [number, number, number]>> = {
  rss: [5, 19, 1],
};

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  /**
   * Render the standard feed mark: white waves on the canonical RSS orange.
   * Only meaningful for `rss`.
   */
  badge?: boolean;
  /** Accessible label. Omit for decorative icons sitting beside visible text. */
  label?: string;
  class?: string;
}

const { name, badge = false, label, class: className } = Astro.props;

const paths = ICONS[name];
const dot = DOTS[name];

const a11y = {
  'aria-hidden': label ? undefined : ('true' as const),
  'aria-label': label,
  role: label ? ('img' as const) : undefined,
};
---

{badge && name === 'rss' ? (
  <svg
    class:list={['icon', 'icon--badge', className]}
    viewBox="0 0 24 24"
    fill="none"
    {...a11y}
  >
    <rect width="24" height="24" rx="5" fill="#FF6600" />
    <circle cx="6.6" cy="17.4" r="2.1" fill="#fff" />
    <path
      d="M4.5 12.5a7 7 0 0 1 7 7"
      stroke="#fff"
      stroke-width="2.6"
      stroke-linecap="round"
    />
    <path
      d="M4.5 7a12.5 12.5 0 0 1 12.5 12.5"
      stroke="#fff"
      stroke-width="2.6"
      stroke-linecap="round"
    />
  </svg>
) : (
  <svg
    class:list={['icon', className]}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    {...a11y}
  >
    {paths.map((d) => <path d={d} />)}
    {dot && <circle cx={dot[0]} cy={dot[1]} r={dot[2]} fill="currentColor" stroke="none" />}
  </svg>
)}
