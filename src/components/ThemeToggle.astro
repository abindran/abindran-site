---
import Icon from './Icon.astro';
---

{/*
  Hidden until the inline head script marks the document as scripted — without
  JS the button could not do anything, so showing it would be a dead control.
*/}
<button type="button" class="theme-toggle" data-theme-toggle aria-live="polite">
  <Icon name="sun" class="theme-toggle__icon theme-toggle__icon--sun" />
  <Icon name="moon" class="theme-toggle__icon theme-toggle__icon--moon" />
  <span class="visually-hidden" data-theme-label>Toggle theme</span>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = document.querySelector<HTMLElement>('[data-theme-label]');

  const systemPrefersDark = () =>
    window.matchMedia('(prefers-color-scheme: dark)').matches;

  /** What is actually on screen right now. */
  const currentTheme = (): 'light' | 'dark' => {
    const explicit = root.dataset.theme;
    if (explicit === 'light' || explicit === 'dark') return explicit;
    return systemPrefersDark() ? 'dark' : 'light';
  };

  const describe = () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    const text = `Switch to ${next} theme`;
    button?.setAttribute('aria-label', text);
    if (label) label.textContent = text;
  };

  button?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private mode or storage disabled: the choice simply will not persist.
    }
    describe();
  });

  // Follow the system while the reader has expressed no explicit preference.
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (!root.dataset.theme) describe();
    });

  describe();
</script>
