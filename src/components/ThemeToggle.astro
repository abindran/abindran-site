---
import Icon from './Icon.astro';
---

{/*
  Hidden until the inline head script marks the document as scripted — without
  JS the button could not do anything, so showing it would be a dead control.
*/}
<button type="button" class="theme-toggle" data-theme-toggle aria-live="polite">
  <Icon name="sun" class="theme-toggle__icon theme-toggle__icon--sun" />
  <Icon name="moon" class="theme-toggle__icon theme-toggle__icon--moon" />
  <span class="visually-hidden" data-theme-label>Toggle theme</span>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = document.querySelector<HTMLElement>('[data-theme-label]');
  const favicon = document.querySelector<HTMLLinkElement>('[data-favicon]');

  // Dark is the default, so anything that is not an explicit light choice is
  // dark. The system preference is deliberately not consulted.
  const currentTheme = (): 'light' | 'dark' =>
    root.dataset.theme === 'light' ? 'light' : 'dark';

  const sync = () => {
    const now = currentTheme();
    const next = now === 'dark' ? 'light' : 'dark';
    const text = `Switch to ${next} theme`;
    button?.setAttribute('aria-label', text);
    if (label) label.textContent = text;

    // Favicon cannot follow an in-page toggle via CSS, so swap it here. The
    // 'dark' file is the light-coloured mark, i.e. the one for dark backgrounds.
    if (favicon) {
      favicon.href = now === 'dark' ? '/dark-favicon-32.png' : '/light-favicon-32.png';
    }
  };

  button?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    if (next === 'light') root.dataset.theme = 'light';
    else delete root.dataset.theme;

    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private mode or storage disabled: the choice simply will not persist.
    }
    sync();
  });

  sync();
</script>
