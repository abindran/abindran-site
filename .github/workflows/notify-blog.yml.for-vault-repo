# ============================================================================
# THIS FILE BELONGS IN THE VAULT REPO, NOT HERE.
#
# Copy to:  abindran/Obsidian-Backup  ->  .github/workflows/notify-blog.yml
#
# It fires whenever you push notes, telling the site repo to sync and deploy.
#
# Setup (one time):
#   1. Create a fine-grained PAT at github.com/settings/personal-access-tokens
#        Repository access: only  abindran/abindran-site
#        Permissions:       Contents -> Read and write
#   2. In the VAULT repo: Settings -> Secrets and variables -> Actions
#        New secret named  BLOG_DISPATCH_TOKEN  with that token
# ============================================================================
name: Notify blog

on:
  push:
    branches: [main]
    paths:
      - 'Final Draft/**'   # only published notes trigger a deploy

concurrency:
  group: notify-blog
  cancel-in-progress: true

jobs:
  dispatch:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger site sync
        run: |
          curl --fail --silent --show-error -X POST \
            -H "Authorization: Bearer ${{ secrets.BLOG_DISPATCH_TOKEN }}" \
            -H "Accept: application/vnd.github+json" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            https://api.github.com/repos/abindran/abindran-site/dispatches \
            -d '{"event_type":"obsidian-updated"}'
          echo "Dispatched obsidian-updated to abindran/abindran-site"
